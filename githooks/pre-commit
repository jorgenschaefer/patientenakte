#!/usr/bin/env bash
# Bricht den Commit ab, wenn eine hinzugefügte Zeile einen Begriff der
# Sperrliste enthält.
set -euo pipefail
. "$(dirname "$0")/sperrliste.sh"

liste=$(begriffe)
trap 'rm -f "$liste"' EXIT

git diff --cached -U0 --no-color --no-ext-diff | awk '
  /^\+\+\+ / { datei = substr($0, 7); next }
  /^@@ / { split($3, b, ","); zeile = substr(b[1], 2); next }
  /^\+/ { print datei ":" zeile ":" substr($0, 2); zeile++ }
' | sed 's/^\([^:]*\):\([0-9]*\):/\1 Zeile \2:/' > "$liste.zeilen"
trap 'rm -f "$liste" "$liste.zeilen"' EXIT

if ! pruefen "$liste" < "$liste.zeilen"; then
  echo "Commit abgebrochen: Begriffe aus der Sperrliste im Diff (oben)." >&2
  exit 1
fi
