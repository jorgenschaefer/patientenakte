#!/usr/bin/env bash
# Bricht den Commit ab, wenn die Commit-Message einen Begriff der Sperrliste
# enthält.
set -euo pipefail
. "$(dirname "$0")/sperrliste.sh"

liste=$(begriffe)
trap 'rm -f "$liste"' EXIT

if ! grep -v '^#' "$1" | awk '{ print "Commit-Message Zeile " NR ":" $0 }' \
    | pruefen "$liste"; then
  echo "Commit abgebrochen: Begriffe aus der Sperrliste in der Commit-Message (oben)." >&2
  exit 1
fi
