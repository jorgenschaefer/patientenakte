#!/usr/bin/env bash
# Legt eine Testakte mit einer erfundenen Patientin in einem neuen
# temporären Verzeichnis an und gibt ihren Pfad aus.
#
# Mit --bisherig hat die Akte den bisherigen Aufbau: die alte AKTE.md und
# BEURTEILUNG.md, die das Plugin nicht mehr schreibt, und einen Eintrag der
# Beurteilung ohne Commit, wie ihn ein Gespräch anhängt. Mit --kopie gibt es
# dazu eine Kopie des Plugins, mit --klein eine mit kleinen Stapelgrenzen,
# damit schon diese wenigen Unterlagen in mehreren Stapeln gebaut werden;
# dann zwei Zeilen: Akte und Plugin.
#
#   .claude/skills/run/neue-testakte [--bisherig] [--kopie | --klein]
set -euo pipefail

plugin=$(cd "$(dirname "$0")/../../.." && pwd)
bisherig='' mit_kopie='' klein=''
for option in "$@"; do
  case $option in
    --bisherig) bisherig=1 ;;
    --kopie) mit_kopie=1 ;;
    --klein) mit_kopie=1 klein=1 ;;
    *) echo "Aufruf: $0 [--bisherig] [--kopie | --klein]" >&2; exit 2 ;;
  esac
done
akte=$(mktemp -d -t testakte-XXXXXX)

kopie=''
if [[ -n $mit_kopie ]]; then
  kopie=$(mktemp -d -t testplugin-XXXXXX)
  cp -r "$plugin/." "$kopie"
  rm -rf "$kopie/.git"
  plugin=$kopie
fi
if [[ -n $klein ]]; then
  sed -i 's/^seiten_je_stapel=.*/seiten_je_stapel=2/; s/^zeichen_je_seite=.*/zeichen_je_seite=500/' "$kopie/bin/akte-stand"
  if ! grep -qx 'seiten_je_stapel=2' "$kopie/bin/akte-stand" || ! grep -qx 'zeichen_je_seite=500' "$kopie/bin/akte-stand"; then
    echo "seiten_je_stapel= oder zeichen_je_seite= nicht in bin/akte-stand gefunden; --klein an die neuen Namen anpassen." >&2
    exit 1
  fi
fi

cd "$akte"
git init -q
mkdir unterlagen literatur
cp "$plugin/vorlagen/literatur-README.md" literatur/README.md
sed -i 's/^|---|---|---|---|---|---|---|$/&\n| testleitlinie-hypertonie.txt | Erfundene Leitlinie für die Testakte | 2024 | 2029 | 10.01.2025 | 10.01.2025 | erfunden |/' literatur/README.md

cat > literatur/testleitlinie-hypertonie.txt <<'LEITLINIE'
Erfundene Leitlinie für die Testakte des Plugins patientenakte.
Keine echte Empfehlung.

3 Zielwerte

