#!/usr/bin/env bash
# Legt in einer Testakte aus neue-testakte, deren Baum schon gebaut ist,
# nach, was ein schrittweises Einarbeiten braucht: einen committeten Befund,
# der das Kapitel zur Hypertonie und damit die Testleitlinie berührt, und
# einen Eintrag der Beurteilung ohne Commit, wie ihn ein Gespräch anhängt.
#
#   .claude/skills/run/nachtrag <akte>
set -euo pipefail

if [[ $# -ne 1 || ! -f $1/unterlagen/beurteilung.md || ! -f $1/AKTE.md ]]; then
  echo "Aufruf: $0 <akte>; die Akte braucht unterlagen/beurteilung.md und einen gebauten Baum mit AKTE.md." >&2
  exit 2
fi
cd "$1"

# Vier Wochen nach der Erhöhung auf 10 mg ist der Zielwert nicht erreicht:
# Das berührt Empfehlung 3.3 der Testleitlinie, die das Kapitel noch nicht
# nennt.
cat > unterlagen/2025-05-20-befund_hausarzt.md <<'BEFUND'
# Kontrolle Blutdruck, Hausarztpraxis Dr. Beispiel, 20.05.2025

Praxisblutdruck 152/94 mmHg, Ramipril 10 mg seit 15.04.2025 unverändert.
Keine Beschwerden. Wiedervorstellung in vier Wochen.
BEFUND
git add unterlagen/2025-05-20-befund_hausarzt.md
git commit -qm "Befund vom 20.05.2025"

heute=$(date +%d.%m.%Y)
cat >> unterlagen/beurteilung.md <<BEURTEILUNG

## $heute

*Einschätzung eines Modells, nicht ärztlich bestätigt; Anlass: Gespräch über das Knie.*

- **Knie rechts, Belastung – Einschätzung:** Leichtes Joggen ist vertretbar, solange das Knie danach nicht anschwillt. Grund: fast beschwerdefrei nach Physiotherapie, wieder leichtes Joggen [historie 02.10.2025]; kein Gelenkerguss [2025-02-03-mrt_radiologie-nord].
BEURTEILUNG
