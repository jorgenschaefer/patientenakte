#!/usr/bin/env bash
# Spielt regeln.md zu Beginn jeder Sitzung als Kontext ein, in zwei Teilen,
# geteilt vor der Überschrift „# Regeln“: Claude Code übernimmt die Ausgabe
# eines Hooks nur bis etwa 10.000 Zeichen ganz. hooks.json ruft das Script
# darum je Teil einmal auf, den Stand spielt stand-einspielen ein, und
# tests/akte-stand.sh hält die Länge jedes Teils fest.
#
#   regeln-einspielen 1|2
set -uo pipefail

regeln=$CLAUDE_PLUGIN_ROOT/regeln.md
teilung='# Regeln'

case "${1:-}" in
  1)
    printf 'Regeln des Plugins patientenakte, Teil 1 von 2; Teil 2 beginnt mit „%s“.\n\n' "$teilung"
    awk -v t="$teilung" '$0 == t { exit } { print }' "$regeln"
    ;;
  2)
    printf 'Regeln des Plugins patientenakte, Teil 2 von 2.\n\n'
    awk -v t="$teilung" '$0 == t { drin = 1 } drin' "$regeln"
    ;;
  *) echo "Aufruf: $0 1|2" >&2; exit 2 ;;
esac
