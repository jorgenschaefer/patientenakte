#!/usr/bin/env bash
# Vergleicht die Dateien in unterlagen/ mit den Prüfsummen des Baums aus dem
# Überblick AKTE.md und den Kapiteln in kapitel/; prüft den Baum.
#
# Arbeitet im aktuellen Verzeichnis, das die Akte sein muss. Eine Akte mit
# BEURTEILUNG.md hat den bisherigen Aufbau: Dort stehen die Prüfsummen am
# Ende von AKTE.md, und es gibt keinen Baum zu prüfen.
#
#   akte-stand                  listet neue, geänderte und entfernte Dateien,
#                               davor den Commit, mit dem die Prüfsummen
#                               zuletzt committet wurden; meldet einen nicht
#                               abgeschlossenen Bau, also Änderungen ohne
#                               Commit an AKTE.md oder in kapitel/, und den
#                               bisherigen Aufbau. Im neuen Aufbau meldet es
#                               auch einen fehlenden Überblick, Überblick und
#                               Kapitel über ihrer Höchstlänge, Verweise ins
#                               Leere und abgelaufene Fristen des Überblicks
#   akte-stand --aktualisieren  schreibt die aktuellen Prüfsummen in
#                               kapitel/grundlage.md, im bisherigen Aufbau
#                               ans Ende von AKTE.md
#   akte-stand --vorlage        meldet, ob der Überblick oder ein Kapitel im
#                               Gerüst von seiner Vorlage in vorlagen/
#                               abweicht; im bisherigen Aufbau nichts
#   akte-stand --stapel         teilt die Unterlagen in der Reihenfolge ihres
#                               Datums in Stapel für einen Bau von AKTE.md;
#                               braucht pdfinfo aus poppler-utils, wenn
#                               unter den Unterlagen ein PDF ist
#   akte-stand --einheit <zeile>  gibt einen Teil von historie.md oder
#                               beurteilung.md aus, wie --stapel ihn als
#                               Zeile ausgibt
set -euo pipefail

akte=AKTE.md
seiten_je_stapel=20
# Höchstlängen in Wörtern, gezählt wie von `wc -w`: alles zwischen
# Leerraum, auch Markdown wie # oder |; die Agenten lesen sie hier.
woerter_ueberblick=2000
woerter_kapitel=1500
zeichen_je_seite=10000
verzeichnis=unterlagen
historie=$verzeichnis/historie.md
# Die Beurteilung: Einschätzungen eines Modells, nur angehängt.
beurteilung=$verzeichnis/beurteilung.md
# Eine Überschrift über einem Tag in historie.md oder beurteilung.md, mit dem
# Datum in drei Gruppen.
ueberschrift='^## ([0-9]{2})\.([0-9]{2})\.([0-9]{4})[[:space:]]*$'
anfang='<!-- akte-stand: Anfang -->'
ende='<!-- akte-stand: Ende -->'
vorlagen=$(dirname "$(readlink -f "$0")")/../vorlagen
kapitel=kapitel
# Die Prüfsummen des Baums. Sie stehen nicht im Überblick, weil der in
# jeder Sitzung ganz im Kontext ist; grundlage.md ist kein Kapitel.
grundlage=$kapitel/grundlage.md
# Ein Überblick nennt das Ende seiner Fristen in dieser Überschrift.
fristen='^## Fristen bis ([0-9]{2})\.([0-9]{2})\.([0-9]{4})[[:space:]]*$'

if [[ ! -f $akte && ! -d $verzeichnis ]]; then
  echo "$PWD ist keine Akte: weder $akte noch $verzeichnis/ gefunden." >&2
  exit 1
fi

bisheriger_aufbau=
if [[ -f BEURTEILUNG.md ]]; then
  bisheriger_aufbau=1
  grundlage=$akte
fi

aktuell() {
  [[ -d $verzeichnis ]] || return 0
  find "$verzeichnis" -type f ! -name '.*' -print0 | sort -z | xargs -0 -r sha256sum
}

gespeichert() {
  [[ -f $grundlage ]] || return 0
  awk -v a="$anfang" -v e="$ende" \
    '$0 == a { drin = 1; next } $0 == e { drin = 0 } drin && /^[0-9a-f]{64}  /' "$grundlage"
}

# Der letzte Commit, der Prüfsummenzeilen geändert hat; leer ohne Git oder
# ohne solchen Commit. Von dort zeigt `git diff`, was in einer geänderten
# Unterlage seit dem letzten Bau neu ist.
eingearbeitet() {
  git log -1 --format=%h -G '^[0-9a-f]{64}  ' -- "$grundlage" 2>/dev/null || true
}

# Der Baum wird am Ende jedes Baus committet (Subagent akte-nachziehen),
# nicht committete Änderungen stammen also aus einem nicht abgeschlossenen Bau.
nicht_abgeschlossen() {
  if [[ -n $bisheriger_aufbau ]]; then
    [[ -f $akte && -n $(git status --porcelain -- "$akte" 2>/dev/null) ]]
  else
    [[ -n $(git status --porcelain -- "$akte" "$kapitel" 2>/dev/null) ]]
  fi
}

vergleichen() {
  awk '
    FILENAME == ARGV[1] { alt[substr($0, 67)] = substr($0, 1, 64); next }
    {
      pfad = substr($0, 67)
      if (!(pfad in alt)) print "neu: " pfad
      else if (alt[pfad] != substr($0, 1, 64)) print "geändert: " pfad
      delete alt[pfad]
    }
    END { for (pfad in alt) print "entfernt: " pfad }
  ' <(gespeichert) <(aktuell) | sort -t: -k2
}

aktualisieren() {
  local block
  block="$anfang"$'\n''```'$'\n'"$(aktuell)"$'\n''```'$'\n'"$ende"
  if [[ -f $grundlage ]] && grep -qxF "$anfang" "$grundlage"; then
    BLOCK="$block" awk -v a="$anfang" -v e="$ende" '
      $0 == a { print ENVIRON["BLOCK"]; weg = 1; next }
      $0 == e { weg = 0; next }
      !weg
    ' "$grundlage" > "$grundlage.tmp"
    mv "$grundlage.tmp" "$grundlage"
  elif [[ -n $bisheriger_aufbau ]]; then
    if [[ ! -f $akte ]]; then
      echo "$akte fehlt." >&2
      exit 1
    fi
    # shellcheck disable=SC2016 # Backticks sind Markdown.
    printf '\n## Grundlage\n\n*Prüfsummen der eingearbeiteten Unterlagen, geschrieben von `akte-stand --aktualisieren`.*\n\n%s\n' "$block" >> "$akte"
  else
    mkdir -p "$kapitel"
    # shellcheck disable=SC2016 # Backticks sind Markdown.
    printf '# Grundlage\n\n*Prüfsummen der in AKTE.md und kapitel/ eingearbeiteten Unterlagen, geschrieben von `akte-stand --aktualisieren`. Kein Kapitel.*\n\n%s\n' "$block" >> "$grundlage"
  fi
}

# Was am Baum zu beheben ist: Überblick und Kapitel über ihrer Höchstlänge,
# Verweise ins Leere und abgelaufene Fristen.
baum_pruefen() {
  [[ ! -f $akte ]] || laenge_pruefen "$akte" "$woerter_ueberblick"
  local datei
  while IFS= read -r -d '' datei; do
    laenge_pruefen "$datei" "$woerter_kapitel"
  done < <(kapitel_dateien)
  while IFS= read -r -d '' datei; do
    verweise_pruefen "$datei"
  done < <([[ ! -f $akte ]] || printf '%s\0' "$akte"; kapitel_dateien)
  [[ ! -f $akte ]] || fristen_pruefen
}

# Die Kapitel und Unterkapitel, sortiert und durch Nullbytes getrennt.
kapitel_dateien() {
  [[ -d $kapitel ]] || return 0
  find "$kapitel" -type f -name '*.md' ! -path "$grundlage" -print0 | sort -z
}

laenge_pruefen() { # Datei, Höchstlänge
  local woerter
  woerter=$(wc -w < "$1")
  if ((woerter > $2)); then
    echo "$1 hat $woerter Wörter, mehr als die Höchstlänge von $2."
  fi
}

# Ein Verweis ist ein Markdown-Link mit einem Pfad relativ zu seiner Datei;
# Adressen mit Schema wie https: und Anker in derselben Datei sind keine.
verweise_pruefen() {
  local link ziel
  while IFS= read -r link; do
    ziel=${link:2:${#link}-3}
    if [[ $ziel == \<* ]]; then
      ziel=${ziel#<}
      ziel=${ziel%%>*}
    else
      ziel=${ziel%%[[:space:]]*}
    fi
    [[ ! $ziel =~ ^[[:alpha:]][[:alnum:]+.-]*: && $ziel != \#* ]] || continue
    ziel=${ziel%%#*}
    [[ -e $(dirname "$1")/$ziel ]] || echo "Verweis ins Leere in $1: $ziel"
  done < <(grep -oE '\]\([^)]+\)' "$1" || true)
}

fristen_pruefen() {
  local zeile
  while IFS= read -r zeile || [[ -n $zeile ]]; do
    [[ $zeile == '## Fristen'* ]] || continue
    if [[ ! $zeile =~ $fristen ]] ||
      ! date -d "${BASH_REMATCH[3]}-${BASH_REMATCH[2]}-${BASH_REMATCH[1]}" > /dev/null 2>&1; then
      echo "Die Überschrift der Fristen in $akte nennt kein Datum als TT.MM.JJJJ: $zeile"
      return
    fi
    local tag=${BASH_REMATCH[3]}${BASH_REMATCH[2]}${BASH_REMATCH[1]}
    if [[ $tag < $(date +%Y%m%d) ]]; then
      echo "Die Fristen in $akte reichen bis ${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[3]}; das Datum ist vorbei."
    fi
    return
  done < "$akte"
}

# Das Gerüst einer Datei: die Überschriften und die kursiven Hinweise, die
# direkt unter einer Überschrift stehen.
geruest() {
  awk '
    /^#+ / { print; hinweis = 1; next }
    /^[[:space:]]*$/ { next }
    hinweis && /^\*[^*].*\*$/ { print; next }
    { hinweis = 0 }
  ' "$1"
}

# Überblick und Kapitel mit dem Gerüst ihrer Vorlage: das Datum der Fristen
# und der Titel eines Kapitels gehören nicht dazu. Die Beurteilung schreibt
# das Angleichen nie um, sie wird darum nicht verglichen. Im bisherigen
# Aufbau meldet der Stand die Abweichung vom neuen Aufbau.
vorlage_pruefen() {
  [[ -z $bisheriger_aufbau ]] || return 0
  if [[ -f $akte ]] && ! cmp -s <(ueberblick_geruest "$vorlagen/$akte") <(ueberblick_geruest "$akte"); then
    echo "$akte weicht von der Vorlage ab."
  fi
  local datei
  while IFS= read -r -d '' datei; do
    if ! cmp -s <(kapitel_geruest "$vorlagen/kapitel.md") <(kapitel_geruest "$datei"); then
      echo "$datei weicht von der Vorlage ab."
    fi
  done < <(kapitel_dateien)
}

ueberblick_geruest() {
  geruest "$1" | sed -E 's/^## Fristen bis [0-9]{2}\.[0-9]{2}\.[0-9]{4}[[:space:]]*$/## Fristen bis TT.MM.JJJJ/'
}

kapitel_geruest() {
  geruest "$1" | sed '/^# /d'
}

# Eine Zeile je Stapel und darunter seine Einheiten, Stapel durch eine
# Leerzeile getrennt. Die Agenten lesen dieses Format.
stapel() {
  if [[ -n $(pdfs) ]] && ! command -v pdfinfo > /dev/null; then
    echo "akte-stand --stapel braucht pdfinfo, um die Seiten der PDFs zu zählen; poppler-utils installieren, etwa mit \`apt install poppler-utils\`." >&2
    exit 1
  fi
  # Seiten zählen Zeichen, nicht Bytes, gleich welche Sprache eingestellt ist.
  local -x LC_ALL=C.UTF-8
  local historie_tage='' beurteilung_tage='' ohne_ueberschriften=''
  if [[ -f $historie ]]; then
    historie_tage=$(tage "$historie" 2)
    [[ -n $historie_tage ]] || ohne_ueberschriften+=" ${historie##*/}"
  fi
  if [[ -f $beurteilung ]]; then
    beurteilung_tage=$(tage "$beurteilung" 3)
    [[ -n $beurteilung_tage ]] || ohne_ueberschriften+=" ${beurteilung##*/}"
  fi
  einheiten "$historie_tage" "$beurteilung_tage" | sort -t $'\t' -k1,1 |
    stapel_schneiden "$ohne_ueberschriften"
}

pdfs() {
  [[ -d $verzeichnis ]] || return 0
  find "$verzeichnis" -type f -iname '*.pdf' ! -name '.*'
}

# Je Einheit eine Zeile: Sortierschlüssel, Gewicht in Zeichen (eine Seite
# zählt zeichen_je_seite, ? ohne bestimmbare Seitenzahl) und der Eintrag,
# wie er in der Ausgabe steht. Erhält die Tage von historie.md und von
# beurteilung.md aus tage(); ohne Tage ist die Datei eine Einheit.
einheiten() {
  [[ -d $verzeichnis ]] || return 0
  local pfad
  while IFS= read -r -d '' pfad; do
    if [[ $pfad == "$historie" && -n $1 ]]; then
      echo "$1"
      continue
    fi
    if [[ $pfad == "$beurteilung" && -n $2 ]]; then
      echo "$2"
      continue
    fi
    printf '%s\t%s\t%s\n' "$(sortierschluessel "$pfad")" "$(gewicht "$pfad")" "$pfad"
  done < <(find "$verzeichnis" -type f ! -name '.*' -print0)
}

# Die Abschnitte von historie.md oder beurteilung.md mit einem Datum im
# Zeitraum der Zeile, in der Reihenfolge der Datei; beginnt er mit dem
# frühesten Tag, auch der Text vor der ersten Überschrift, wie ihn tage()
# zählt.
einheit() {
  local muster='^('$historie'|'$beurteilung') ([0-9]{2})\.([0-9]{2})\.([0-9]{4})–([0-9]{2})\.([0-9]{2})\.([0-9]{4})$'
  if [[ ! $1 =~ $muster ]]; then
    echo "akte-stand --einheit nimmt einen Teil von $historie oder $beurteilung, wie --stapel ihn ausgibt, etwa \"$historie 03.02.2025–17.06.2025\"; bekommen: $1" >&2
    exit 2
  fi
  local datei=${BASH_REMATCH[1]}
  local von=${BASH_REMATCH[4]}${BASH_REMATCH[3]}${BASH_REMATCH[2]}
  local bis=${BASH_REMATCH[7]}${BASH_REMATCH[6]}${BASH_REMATCH[5]}
  if [[ ! -f $datei ]]; then
    echo "$datei gibt es nicht." >&2
    exit 1
  fi
  local erster zeile tag='' ausgabe='' gefunden=''
  erster=$(tage "$datei" 0 | sort | head -1 | cut -d ' ' -f 2)
  while IFS= read -r zeile || [[ -n $zeile ]]; do
    if [[ $zeile =~ $ueberschrift ]]; then
      tag=${BASH_REMATCH[3]}${BASH_REMATCH[2]}${BASH_REMATCH[1]}
    fi
    if [[ -n $tag && ! $tag < $von && ! $tag > $bis ]]; then
      gefunden=1
      ausgabe+=$zeile$'\n'
    elif [[ -z $tag && $von == "$erster" ]]; then
      ausgabe+=$zeile$'\n'
    fi
  done < "$datei"
  if [[ -z $gefunden ]]; then
    echo "$datei hat keinen Abschnitt vom ${von:6:2}.${von:4:2}.${von:0:4} bis ${bis:6:2}.${bis:4:2}.${bis:0:4}." >&2
    exit 1
  fi
  printf '%s' "$ausgabe"
}

# Je Tag in einer Datei mit Datumsüberschriften eine Einheit wie in
# einheiten(), gewogen mit seinen Zeichen ohne Aufrunden; am selben Datum
# sortiert nach dem Rang. Mehrere Überschriften mit demselben Datum sind ein
# Tag; der Text vor der ersten Überschrift gehört zum frühesten Tag. Ohne
# Überschrift keine Ausgabe.
tage() { # Datei, Rang
  local datei=$1 rang=$2
  local zeile tag='' vorab=0
  local -A zeichen=()
  while IFS= read -r zeile || [[ -n $zeile ]]; do
    if [[ $zeile =~ $ueberschrift ]]; then
      tag=${BASH_REMATCH[3]}${BASH_REMATCH[2]}${BASH_REMATCH[1]}
    fi
    if [[ -z $tag ]]; then
      vorab=$((vorab + ${#zeile} + 1))
    else
      zeichen[$tag]=$((${zeichen[$tag]:-0} + ${#zeile} + 1))
    fi
  done < "$datei"
  ((${#zeichen[@]})) || return 0
  local erster=''
  for tag in "${!zeichen[@]}"; do
    [[ -n $erster && $erster < $tag ]] || erster=$tag
  done
  zeichen[$erster]=$((zeichen[$erster] + vorab))
  for tag in "${!zeichen[@]}"; do
    printf '0 %s %s %s\t%s\t%s %s.%s.%s\n' "$tag" "$rang" "$datei" "${zeichen[$tag]}" \
      "$datei" "${tag:6:2}" "${tag:4:2}" "${tag:0:4}"
  done
}

# Erst die datierten Einheiten nach Datum, bei gleichem Datum Befunde vor
# anamnese.md vor historie.md vor beurteilung.md; dann die Dateien ohne
# Datum, dann die CSVs.
sortierschluessel() {
  local datum
  if [[ $1 == *.csv ]]; then
    echo "2 $1"
  elif [[ $(basename "$1") =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2}) ]]; then
    echo "0 ${BASH_REMATCH[1]}${BASH_REMATCH[2]}${BASH_REMATCH[3]} 0 $1"
  elif [[ $1 == "$verzeichnis/anamnese.md" ]] && datum=$(anamnese_datum) && [[ -n $datum ]]; then
    echo "0 $datum 1 $1"
  else
    echo "1 $1"
  fi
}

# Das letzte Datum in der Kopfzeile von anamnese.md als JJJJMMTT, ohne
# Datum dort das ihres ersten Commits; leer ohne beides.
anamnese_datum() {
  local datum
  datum=$(kopfzeilen_datum)
  [[ -n $datum ]] ||
    datum=$({ git log --diff-filter=A --format=%as -- "$verzeichnis/anamnese.md" 2>/dev/null || true; } | tail -1 | tr -d -)
  echo "$datum"
}

# Die Kopfzeile ist die erste Zeile unter dem Titel, wenn sie kursiv ist.
kopfzeilen_datum() {
  awk '
    !titel { titel = /^# /; next }
    /^[[:space:]]*$/ { next }
    !/^\*[^*]/ { exit }
    {
      while (match($0, /[0-9][0-9]\.[0-9][0-9]\.[0-9][0-9][0-9][0-9]/)) {
        datum = substr($0, RSTART, RLENGTH)
        $0 = substr($0, RSTART + RLENGTH)
      }
      if (datum) print substr(datum, 7, 4) substr(datum, 4, 2) substr(datum, 1, 2)
      exit
    }
  ' "$verzeichnis/anamnese.md"
}

gewicht() {
  local seiten
  case "${1,,}" in
    *.pdf)
      seiten=$({ pdfinfo "$1" 2>/dev/null || true; } | awk '$1 == "Pages:" { print $2 }')
      if [[ $seiten =~ ^[0-9]+$ ]]; then
        echo $((seiten * zeichen_je_seite))
      else
        echo '?'
      fi
      ;;
    *.jpg | *.jpeg | *.png) echo "$zeichen_je_seite" ;;
    *) echo $((($(wc -m < "$1") + zeichen_je_seite - 1) / zeichen_je_seite * zeichen_je_seite)) ;;
  esac
}

# Eine Einheit kommt in den laufenden Stapel, solange er damit höchstens
# seiten_je_stapel Seiten hat; aufgerundet wird erst die Summe des Stapels.
# Ein PDF ohne Seitenzahl bildet einen Stapel für sich. Danach die Hinweise:
# PDFs ohne Seitenzahl und die Dateien in $1, die keine Datumsüberschriften
# haben.
stapel_schneiden() {
  awk -F '\t' -v grenze=$((seiten_je_stapel * zeichen_je_seite)) \
      -v zeichen_je_seite="$zeichen_je_seite" \
      -v datiert="$historie $beurteilung" -v ohne_ueberschriften="$1" '
    BEGIN {
      split(datiert, d, " ")
      for (i in d) mit_tagen[d[i]] = 1
      n_ohne = split(ohne_ueberschriften, ohne, " ")
    }
    $2 == "?" {
      abschliessen()
      zeilen[++n] = $3; bis[n] = ""; summe = "?"
      abschliessen()
      unbekannt[++u] = $3
      next
    }
    n && summe + $2 > grenze { abschliessen() }
    { summe += $2 }
    # Ein Tag: Datei und Datum, durch ein Leerzeichen getrennt.
    { leer = index($3, " "); datei = substr($3, 1, leer - 1) }
    # Aufeinander folgende Tage derselben Datei stehen auf einer Zeile.
    leer && datei in mit_tagen && n && bis[n] && zeilen[n] == datei {
      bis[n] = substr($3, leer + 1)
      next
    }
    leer && datei in mit_tagen {
      zeilen[++n] = datei
      von[n] = bis[n] = substr($3, leer + 1)
      next
    }
    { zeilen[++n] = $3; bis[n] = "" }
    END {
      abschliessen()
      if (u || n_ohne) print ""
      for (i = 1; i <= u; i++) print "Seitenzahl unbekannt: " unbekannt[i]
      for (i = 1; i <= n_ohne; i++) print ohne[i] " ohne Datumsüberschriften."
    }

    function abschliessen(  i) {
      if (!n) return
      if (stapel) print ""
      printf "Stapel %d (%s Seiten)\n", ++stapel, summe == "?" ? "?" : int((summe + zeichen_je_seite - 1) / zeichen_je_seite)
      for (i = 1; i <= n; i++) print zeilen[i] (bis[i] ? " " von[i] "–" bis[i] : "")
      n = summe = 0
    }
  '
}

case "${1:-}" in
  "")
    ergebnis=$(vergleichen)
    offen=
    if [[ -n $bisheriger_aufbau ]]; then
      echo "Die Akte hat den bisherigen Aufbau mit BEURTEILUNG.md und weicht vom neuen Aufbau aus $akte und $kapitel/ ab."
    fi
    if nicht_abgeschlossen; then
      offen=1
      if [[ -n $bisheriger_aufbau ]]; then
        echo "$akte hat Änderungen ohne Commit aus einem Bau, der nicht abgeschlossen ist."
      else
        echo "$akte oder $kapitel/ hat Änderungen ohne Commit aus einem Bau, der nicht abgeschlossen ist."
      fi
    fi
    [[ -n $bisheriger_aufbau || -f $akte ]] || echo "Der Überblick $akte fehlt."
    if [[ -n $ergebnis ]]; then
      # Ein nicht committeter Bau hat schon Teile dieses Diffs eingearbeitet.
      commit=
      [[ -n $offen ]] || commit=$(eingearbeitet)
      [[ -z $commit ]] || echo "Eingearbeitet bis Commit $commit."
      echo "$ergebnis"
    elif [[ -z $offen && -n $bisheriger_aufbau ]]; then
      echo "$akte ist auf dem Stand von $verzeichnis/."
    elif [[ -z $offen && -f $akte ]]; then
      echo "$akte und $kapitel/ sind auf dem Stand von $verzeichnis/."
    fi
    [[ -n $bisheriger_aufbau ]] || baum_pruefen
    ;;
  --aktualisieren) aktualisieren ;;
  --vorlage) vorlage_pruefen ;;
  --stapel) stapel ;;
  --einheit) einheit "${2:-}" ;;
  *) echo "Aufruf: $0 [--aktualisieren | --vorlage | --stapel | --einheit <zeile>]" >&2; exit 2 ;;
esac
